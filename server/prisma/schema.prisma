datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         String         // "PATIENT" | "DOCTOR" | "RECEPTIONIST" | "PHARMACIST" | "ADMIN"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  patient      Patient?
  doctor       Doctor?
  auditLogs    AuditLog[]
  notifications Notification[]
}

model Patient {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  dob              DateTime
  gender           String
  bloodGroup       String
  address          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointments     Appointment[]
  diagnosisRecords DiagnosisRecord[]
  prescriptions    Prescription[]
  bills            Bill[]
}

model Doctor {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  specialization   String
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id])
  phone            String
  email            String
  schedule         String?           // JSON string
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointments     Appointment[]
  diagnosisRecords DiagnosisRecord[]
  prescriptions    Prescription[]
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctors     Doctor[]
}

model Appointment {
  id               String           @id @default(uuid())
  patientId        String
  patient          Patient          @relation(fields: [patientId], references: [id])
  doctorId         String
  doctor           Doctor           @relation(fields: [doctorId], references: [id])
  slotDateTime     DateTime
  status           String           @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED"
  reason           String
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  diagnosisRecord  DiagnosisRecord?
  prescription     Prescription?
  bill             Bill?
}

model DiagnosisRecord {
  id             String       @id @default(uuid())
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  symptoms       String
  clinicalsummary  String?       // AI generated clinical summary only
  finalDiagnosis String?
  status         String       @default("PENDING") // "PENDING" | "CONFIRMED"
  confirmedBy    String?
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescriptions  Prescription[]
}

model Medicine {
  id            String   @id @default(uuid())
  name          String   @unique
  category      String
  stock         Int
  unit          String   // e.g. "tablets", "bottles"
  minStockLimit Int      @default(10)
  price         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Prescription {
  id                String           @id @default(uuid())
  appointmentId     String?          @unique
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor           @relation(fields: [doctorId], references: [id])
  diagnosisRecordId String?
  diagnosisRecord   DiagnosisRecord? @relation(fields: [diagnosisRecordId], references: [id])
  status            String           @default("PENDING") // "PENDING" | "DISPENSED"
  medicines         String           // JSON string array
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Bill {
  id            String       @id @default(uuid())
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  amount        Float
  status        String       @default("PENDING") // "PENDING" | "PAID"
  items         String       // JSON string array
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
