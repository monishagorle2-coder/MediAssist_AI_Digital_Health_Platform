datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         String         // "PATIENT" | "DOCTOR" | "RECEPTIONIST" | "PHARMACIST" | "ADMIN"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  patient      Patient?
  doctor       Doctor?
  auditLogs    AuditLog[]
  notifications Notification[]
}

model Patient {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  dob              DateTime
  gender           String
  bloodGroup       String
  address          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointments     Appointment[]
  diagnosisRecords DiagnosisRecord[]
  prescriptions    Prescription[]
  bills            Bill[]
  allergies        String?
  chronicConditions String?
  emergencyContactName String?
  emergencyContactPhone String?
  insuranceProvider String?
  insuranceNumber  String?
  vitals           Vitals[]
  labOrders        LabOrder[]
}

model Doctor {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  specialization   String
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id])
  phone            String
  email            String
  schedule         String?           // JSON string
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointments     Appointment[]
  diagnosisRecords DiagnosisRecord[]
  prescriptions    Prescription[]
  doctorSchedules  DoctorSchedule[]
  labOrders        LabOrder[]
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  doctors     Doctor[]
}

model Appointment {
  id                      String           @id @default(uuid())
  patientId               String
  patient                 Patient          @relation(fields: [patientId], references: [id])
  doctorId                String
  doctor                  Doctor           @relation(fields: [doctorId], references: [id])
  slotDateTime            DateTime
  status                  String           @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED"
  queueStatus             String           @default("WAITING") // "WAITING" | "CHECKED_IN" | "IN_CONSULTATION" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  tokenNumber             Int?
  checkedInAt             DateTime?
  consultationStartedAt   DateTime?
  consultationCompletedAt DateTime?
  reason                  String
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  diagnosisRecord         DiagnosisRecord?
  prescription            Prescription?
  bill                    Bill?
  vitals                  Vitals[]
  labOrders               LabOrder[]
}

model DiagnosisRecord {
  id             String       @id @default(uuid())
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  symptoms       String
  clinicalsummary  String?       // AI generated clinical summary only
  finalDiagnosis String?
  status         String       @default("PENDING") // "PENDING" | "CONFIRMED"
  confirmedBy    String?
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescriptions  Prescription[]
  aiSuggestions  String? // JSON payload from AI suggestions
  labOrders      LabOrder[]
}

model Medicine {
  id            String    @id @default(uuid())
  name          String    @unique
  genericName   String?
  category      String
  manufacturer  String?
  batchNumber   String?
  expiryDate    DateTime?
  stock         Int
  unit          String   // e.g. "tablets", "bottles"
  minStockLimit Int      @default(10)
  price         Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Prescription {
  id                String           @id @default(uuid())
  appointmentId     String?          @unique
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor           @relation(fields: [doctorId], references: [id])
  diagnosisRecordId String?
  diagnosisRecord   DiagnosisRecord? @relation(fields: [diagnosisRecordId], references: [id])
  status            String           @default("PENDING") // "PENDING" | "DISPENSED"
  medicines         String           // JSON string array
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Bill {
  id                   String       @id @default(uuid())
  invoiceNumber        String?      @unique
  appointmentId        String?      @unique
  appointment          Appointment? @relation(fields: [appointmentId], references: [id])
  patientId            String
  patient              Patient      @relation(fields: [patientId], references: [id])
  amount               Float        // total amount
  subtotal             Float?
  taxRate              Float?       @default(0)
  taxAmount            Float?       @default(0)
  discountAmount       Float?       @default(0)
  totalAmount          Float?
  status               String       @default("PENDING") // "PENDING" | "PAID"
  paymentStatus        String       @default("PENDING") // "PENDING" | "PAID" | "PARTIALLY_PAID" | "CANCELLED" | "REFUNDED"
  paymentMethod        String?      // "CASH" | "CARD" | "UPI" | "INSURANCE"
  paidAt               DateTime?
  transactionReference String?
  notes                String?
  items                String       // JSON string array for backward compatibility
  billItems            BillItem[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  category    String   // "CONSULTATION" | "PHARMACY" | "LABORATORY" | "PROCEDURE" | "OTHER"
  quantity    Int      @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Vitals {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  bloodPressure String?      // e.g. "120/80"
  pulse         Int?         // bpm
  temperature   Float?       // in Fahrenheit, e.g. 98.6
  spo2          Int?         // % e.g. 98
  weight        Float?       // in kg, e.g. 70.5
  height        Float?       // in cm, e.g. 175.0
  bmi           Float?       // calculated
  recordedBy    String?      // Staff/Doctor user ID or name
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model DoctorSchedule {
  id           String   @id @default(uuid())
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday, 6 = Saturday
  startTime    String   // e.g. "09:00"
  endTime      String   // e.g. "17:00"
  slotDuration Int      @default(15) // in minutes
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([doctorId, dayOfWeek])
}

model LabTest {
  id             String     @id @default(uuid())
  name           String     @unique
  code           String     @unique // e.g. "CBC", "LFT", "KFT", "LIPID", "COVID-RT-PCR"
  category       String     // "Hematology", "Biochemistry", "Microbiology", "Pathology", "Radiology"
  description    String?
  sampleType     String     // "Blood", "Serum", "Plasma", "Urine", "Swab"
  price          Float
  tatHours       Int        @default(24) // Turnaround time in hours
  referenceRange String?    // Default reference parameters or description
  unit           String?    // Default unit
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  labOrders      LabOrder[]
}

model LabOrder {
  id                String           @id @default(uuid())
  orderNumber       String           @unique // e.g. "LAB-2026-0001"
  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor           @relation(fields: [doctorId], references: [id])
  appointmentId     String?
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  diagnosisRecordId String?
  diagnosisRecord   DiagnosisRecord? @relation(fields: [diagnosisRecordId], references: [id])
  labTestId         String
  labTest           LabTest          @relation(fields: [labTestId], references: [id])
  status            String           @default("ORDERED") // "ORDERED" | "SAMPLE_COLLECTED" | "PROCESSING" | "COMPLETED" | "CANCELLED"
  priority          String           @default("ROUTINE") // "ROUTINE" | "URGENT" | "STAT"
  clinicalNotes     String?
  sampleCollectedAt DateTime?
  sampleCollectedBy String?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  labResult         LabResult?
}

model LabResult {
  id               String    @id @default(uuid())
  labOrderId       String    @unique
  labOrder         LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  parameterResults String    // JSON string array: [{ parameter: string, value: string, unit: string, referenceRange: string, flag: 'NORMAL' | 'HIGH' | 'LOW' | 'ABNORMAL' }]
  summary          String    // Overall interpretation / clinical impression
  remarks          String?
  testedBy         String?   // Technician name or ID
  approvedBy       String?   // Doctor / Pathologist name or ID
  resultDate       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

